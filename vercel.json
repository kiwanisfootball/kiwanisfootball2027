{
  "buildCommand": "node generate-index.js",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/articulo/:slug",
      "destination": "/articulo.html"
    }
  ]
}
